# Copy to .env and fill in. NEVER commit .env or put real secrets in this example file.
PORT=3000
NODE_ENV=production
# Your public https address, no trailing slash. Used for share previews, sitemap and the Paystack return URL.
PUBLIC_URL=https://shop.example.com
# Database file. Put it on a disk that survives restarts/redeploys. Never delete it when deploying.
DB_PATH=/var/lib/store/store.db
# Automatic safe copies of the database every 6 hours (last 14 kept). Copy this folder off the server too.
BACKUP_DIR=/var/lib/store/backups
# First owner account, created only when no admin exists yet. Remove ADMIN_PASSWORD after first start.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
# Default delivery fee in whole naira (can be changed later in Admin > Settings)
DELIVERY_FEE=2000
CURRENCY_CODE=NGN
# Paystack dashboard > Settings > API Keys & Webhooks. Use sk_test_... first, then sk_live_...
# This one key also verifies webhook signatures. Server-side only.
PAYSTACK_SECRET_KEY=
# Paystack requires an email; used only when a customer gives none
NOEMAIL_DOMAIN=example.com
# Set to 1 ONLY when running behind a reverse proxy (Caddy/nginx) so rate limits see real client IPs
TRUST_PROXY=1
# No AUTH/session secret is needed: sessions are random tokens stored hashed in the database.
# Not used yet (future): META_APP_ID, META_APP_SECRET, WHATSAPP/SMS/EMAIL provider keys.
